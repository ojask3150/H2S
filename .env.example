# --- Google Earth Engine ---
# Path to the JSON key file for the GEE service account (used in live mode).
GEE_SERVICE_ACCOUNT_JSON=/secure/gee-service-account.json

# "live" = authenticate with GEE and sample real layers (requires the key above)
# "static" = use the bundled synthetic fixture layer (requires no credentials)
GEE_MODE=static

# --- Meteorological feeds ---
# Sources, tried in order. Comma-separated. Any of: nhc, jtwc, custom
MET_SOURCES=nhc,jtwc,custom

# NHC: basin + storm identifier for text products. Leave MET_NHC_STORM_ID empty to
# auto-select the currently active storm in the basin.
MET_NHC_BASIN=al
MET_NHC_STORM_ID=

# JTWC: basin + storm number for ATCF a/b-deck files (e.g. bio022026), or an
# explicit deck URL which overrides the default pattern.
MET_JTWC_BASIN=io
MET_JTWC_STORM_ID=
MET_JTWC_URL=

# Custom: any HTTP endpoint returning the meteorological_json payload
MET_CUSTOM_URL=

# Poll interval for refreshing the met feed (seconds)
MET_POLL_INTERVAL_S=900

# --- Gemini multimodal reasoning engine ---
# Reasoning engine selection:
#   auto          = Gemini when GEMINI_API_KEY is set, else deterministic pipeline
#   gemini        = require Gemini (errors if key/SDK missing)
#   deterministic = always use the local analysis pipeline
REASONING_ENGINE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=high

# --- Output ---
LOG_LEVEL=INFO
